# Block access to sensitive files in project root
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|lock)$">
    Require all denied
</FilesMatch>

# Redirect all requests to public folder
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
