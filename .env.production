APP_NAME="Kodigo Labs"
APP_ENV=production
APP_KEY=base64:mGc33k1SaO4RBKC5pEclrzUpvwjzIp3qMTfk65Eqso0=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://kodigo-labs.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite works on Render Free without a paid database.
# For Postgres later, set DB_CONNECTION=pgsql and real DB_* values (not ${MYSQLHOST}).
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@kodigolabs.com"
MAIL_FROM_NAME="Kodigo Labs"

VITE_APP_NAME="Kodigo Labs"
